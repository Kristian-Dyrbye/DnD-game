{
  "formatVersion": 1,
  "id": "millbrook_demo",
  "name": "Rats in the Old Mill",
  "kind": "test",
  "levelRange": [
    1,
    2
  ],
  "regionId": "aurelmark",
  "summary": "A tiny placeholder adventure used by tests and as the default game until the starter arc exists: the miller's cellar is overrun, and something else lurks below.",
  "start": {
    "chapter": "one",
    "scene": "millbrook_square"
  },
  "chapters": [
    {
      "id": "one",
      "name": "The Old Mill",
      "summary": "Answer the notice, get into the mill, clear the cellar.",
      "start": "millbrook_square",
      "scenes": [
        {
          "id": "millbrook_square",
          "name": "Millbrook Square",
          "locationId": "millbrook",
          "seed": "A cobbled square around a mossy well. Market stalls are closing; the smell of bread drifts from the bakery. A notice board leans by the well.",
          "variants": [
            {
              "if": {
                "flag": "~rats_cleared"
              },
              "seed": "Townsfolk nod at you as you pass. Word of the cleared cellar has spread."
            }
          ],
          "npcs": [
            "mayor_hobb"
          ],
          "mood": "town",
          "pois": [
            {
              "id": "notice_board",
              "name": "Notice board",
              "seed": "Weathered notices, one fresh: 'RATS in the old mill. Reward. Ask Mayor Hobb.'",
              "actions": [
                {
                  "id": "read",
                  "label": "Study the notices",
                  "once": true,
                  "keywords": [
                    "notice",
                    "board",
                    "read"
                  ],
                  "check": {
                    "skill": "investigation",
                    "dc": 10,
                    "success": {
                      "text": "Under the rat notice is an older one, half torn: the miller's cellar key was 'lost' the night he vanished.",
                      "flags": [
                        {
                          "set": "~knows_key"
                        }
                      ]
                    },
                    "failure": {
                      "text": "Only the fresh notice about rats in the old mill is legible."
                    }
                  }
                }
              ]
            }
          ],
          "actions": [
            {
              "id": "talk_mayor",
              "label": "Speak with Mayor Hobb",
              "once": true,
              "keywords": [
                "mayor",
                "hobb",
                "talk",
                "reward"
              ],
              "outcome": {
                "text": "Mayor Hobb promises 10 gold pieces if the mill cellar is cleared, and hands over a spare key to the mill door.",
                "flags": [
                  {
                    "set": "~has_key"
                  }
                ],
                "items": [
                  {
                    "itemId": "torch",
                    "quantity": 2
                  }
                ]
              }
            },
            {
              "id": "claim_reward",
              "label": "Claim the mayor's reward",
              "once": true,
              "if": {
                "flag": "~rats_cleared"
              },
              "keywords": [
                "reward",
                "claim",
                "gold"
              ],
              "outcome": {
                "text": "Mayor Hobb counts out ten gold pieces with evident relief.",
                "coins": 1000,
                "xp": 50,
                "reputation": [
                  {
                    "faction": "crown_of_aurelmark",
                    "delta": 1
                  }
                ],
                "ending": "rats_cleared",
                "flags": [
                  {
                    "set": "~reward_claimed"
                  }
                ]
              }
            }
          ],
          "exits": [
            {
              "id": "to_mill",
              "label": "Walk to the old mill",
              "to": "old_mill",
              "minutes": 15
            }
          ]
        },
        {
          "id": "old_mill",
          "name": "The Old Mill",
          "locationId": "millbrook",
          "seed": "A creaking water wheel turns over a sluggish stream. The mill door is barred with a rusted padlock. Scratching sounds come from below.",
          "exits": [
            {
              "id": "unlock",
              "label": "Unlock the door with the mayor's key",
              "to": "mill_cellar",
              "if": {
                "flag": "~has_key"
              }
            },
            {
              "id": "force",
              "label": "Force the door",
              "to": "mill_cellar",
              "if": {
                "not": {
                  "flag": "~has_key"
                }
              },
              "check": {
                "skill": "athletics",
                "dc": 12,
                "success": {
                  "text": "The rotten hasp splinters and the door swings in."
                },
                "failure": {
                  "text": "The door shudders but holds. Your shoulder aches.",
                  "minutes": 5
                }
              }
            },
            {
              "id": "back",
              "label": "Return to the square",
              "to": "millbrook_square",
              "minutes": 15
            }
          ],
          "map": {
            "id": "old_mill",
            "room": "mill_floor"
          }
        },
        {
          "id": "mill_cellar",
          "name": "Mill Cellar",
          "locationId": "millbrook",
          "seed": "A low cellar of damp flour sacks and gnawed grain barrels. Red eyes glint between the barrels.",
          "mood": "tense",
          "onEnter": {
            "text": "Two giant rats burst from the sacks!",
            "encounter": "cellar_rats"
          },
          "pois": [
            {
              "id": "chest",
              "name": "Miller's strongbox",
              "seed": "A small iron-bound box wedged behind a barrel.",
              "if": {
                "flag": "~rats_cleared"
              },
              "actions": [
                {
                  "id": "open",
                  "label": "Open the strongbox",
                  "once": true,
                  "keywords": [
                    "chest",
                    "box",
                    "open"
                  ],
                  "outcome": {
                    "text": "Inside the box you find what the miller left behind.",
                    "loot": "miller_box"
                  }
                }
              ]
            }
          ],
          "actions": [
            {
              "id": "fight_rats",
              "label": "Fight the rats",
              "if": {
                "not": {
                  "flag": "~rats_cleared"
                }
              },
              "keywords": [
                "fight",
                "attack",
                "rats"
              ],
              "outcome": {
                "encounter": "cellar_rats"
              }
            }
          ],
          "exits": [
            {
              "id": "up",
              "label": "Climb back up to the mill",
              "to": "old_mill"
            }
          ],
          "map": {
            "id": "old_mill",
            "room": "cellar"
          }
        }
      ]
    }
  ],
  "npcs": [
    {
      "id": "mayor_hobb",
      "name": "Mayor Hobb",
      "statBlock": "commoner",
      "personality": "Round, anxious, generous with promises and slow with coin.",
      "secrets": [
        "He sold the miller the bad grain that drew the rats."
      ],
      "voice": "Fussy, breathless, calls everyone 'friend'.",
      "factions": [
        "crown_of_aurelmark"
      ],
      "attitude": "friendly",
      "conversations": [
        {
          "id": "mill_talk",
          "label": "Ask Mayor Hobb about the old mill",
          "keywords": [
            "ask",
            "miller",
            "question"
          ],
          "if": {
            "not": {
              "flag": "~rats_cleared"
            }
          },
          "start": "greet",
          "nodes": [
            {
              "id": "greet",
              "text": "Friend! You've seen the notice, then? Dreadful business at the old mill. What can I tell you?",
              "options": [
                {
                  "id": "miller",
                  "label": "\"What happened to the miller?\"",
                  "once": true,
                  "keywords": [
                    "miller",
                    "happened"
                  ],
                  "next": "miller"
                },
                {
                  "id": "sense",
                  "label": "Watch his face as he talks about the mill",
                  "once": true,
                  "keywords": [
                    "watch",
                    "face",
                    "lying"
                  ],
                  "check": {
                    "skill": "insight",
                    "dc": 12,
                    "success": {
                      "text": "His eyes dart to the granary whenever the mill comes up: he is hiding something about the grain.",
                      "flags": [
                        {
                          "set": "~hobb_nervous"
                        }
                      ]
                    },
                    "failure": {
                      "text": "He seems nothing more than a worried, fussy man."
                    }
                  },
                  "next": "greet"
                },
                {
                  "id": "press",
                  "label": "\"Your grain drew those rats, didn't it?\"",
                  "if": {
                    "flag": "~hobb_nervous"
                  },
                  "once": true,
                  "keywords": [
                    "grain",
                    "threaten",
                    "blame"
                  ],
                  "check": {
                    "skill": "intimidation",
                    "dc": 13,
                    "success": {
                      "flags": [
                        {
                          "set": "~hobb_confessed"
                        }
                      ],
                      "coins": 500
                    },
                    "failure": {
                      "text": "The mayor puffs himself up and turns red."
                    }
                  },
                  "next": "confess",
                  "nextOnFail": "bluster"
                },
                {
                  "id": "leave",
                  "label": "\"I'll see what I can do.\""
                }
              ]
            },
            {
              "id": "miller",
              "text": "Aldo? Gone a week now. Left his cellar key behind, they say. Or lost it. Odd fellow, always muttering about the dark under the mill.",
              "options": [
                {
                  "id": "back",
                  "label": "\"Tell me more about the mill.\"",
                  "next": "greet"
                }
              ]
            },
            {
              "id": "confess",
              "text": "All right, all right! The grain was bad and I sold it to him cheap. Here, five gold more for your trouble, and keep it quiet, friend.",
              "options": [
                {
                  "id": "back",
                  "label": "\"Anything else I should know?\"",
                  "next": "greet"
                }
              ]
            },
            {
              "id": "bluster",
              "text": "How dare you! I am the mayor of this town, and I'll thank you to remember it!"
            }
          ]
        }
      ]
    }
  ],
  "encounters": [
    {
      "id": "cellar_rats",
      "name": "Cellar rats",
      "monsters": [
        {
          "id": "giant_rat",
          "count": 2
        }
      ],
      "terrain": [
        "barrels (half cover)",
        "flour sacks (difficult terrain)"
      ],
      "win": {
        "text": "The last rat squeals and lies still.",
        "flags": [
          {
            "set": "~rats_cleared"
          }
        ],
        "xp": 50
      },
      "lose": {
        "text": "You wake up in the square, bitten and bruised; a farmer dragged you out.",
        "goto": "millbrook_square"
      },
      "flee": {
        "text": "You scramble up the ladder and slam the hatch.",
        "goto": "old_mill"
      },
      "map": "old_mill",
      "room": "cellar"
    }
  ],
  "beats": [
    {
      "id": "rat_return",
      "text": "Walking back into the square, you hear children cheering about the rats.",
      "trigger": {
        "flag": "~rats_cleared"
      },
      "scenes": [
        "millbrook_square"
      ]
    }
  ],
  "lootTables": [
    {
      "id": "miller_box",
      "rolls": 1,
      "entries": [
        {
          "weight": 1,
          "itemId": "potion_of_healing",
          "coins": "2d6",
          "coinUnit": "sp"
        }
      ]
    }
  ],
  "flags": [
    {
      "id": "~knows_key",
      "description": "Read the torn notice about the miller's key."
    },
    {
      "id": "~has_key",
      "description": "Got the mill key from the mayor."
    },
    {
      "id": "~rats_cleared",
      "description": "Cleared the mill cellar."
    },
    {
      "id": "~reward_claimed",
      "description": "Claimed the mayor's reward."
    },
    {
      "id": "~hobb_nervous",
      "description": "Saw through Mayor Hobb's nerves about the grain (conversation)."
    },
    {
      "id": "~hobb_confessed",
      "description": "Mayor Hobb admitted selling the miller bad grain (conversation)."
    }
  ],
  "endings": [
    {
      "id": "rats_cleared",
      "name": "Rats cleared",
      "text": "Millbrook's mill is safe again, for now."
    }
  ],
  "quests": [
    {
      "id": "rat_problem",
      "name": "The rats in the old mill",
      "objectives": [
        {
          "id": "learn",
          "text": "Find out who posted the notice about the rats",
          "done": {
            "flag": "~has_key"
          }
        },
        {
          "id": "enter",
          "text": "Get into the old mill's cellar",
          "done": {
            "visited": "mill_cellar"
          },
          "if": {
            "flag": "~has_key"
          }
        },
        {
          "id": "clear",
          "text": "Deal with whatever is in the cellar",
          "done": {
            "flag": "~rats_cleared"
          },
          "if": {
            "visited": "mill_cellar"
          }
        },
        {
          "id": "reward",
          "text": "Return to Mayor Hobb for the reward",
          "done": {
            "flag": "~reward_claimed"
          },
          "if": {
            "flag": "~rats_cleared"
          }
        }
      ]
    }
  ],
  "maps": [
