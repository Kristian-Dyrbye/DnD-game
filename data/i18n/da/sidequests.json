    "questTypes/hunt_fugitive/outcomes/kill/text": {
      "hash": "e55a6b4d",
      "text": "Det går hurtigt, og {antagonist} kommer aldrig til at flygte igen."
    },
    "questTypes/hunt_fugitive/outcomes/let_go/label": {
      "hash": "fa808a9d",
      "text": "Lad {antagonist} gå mod et løfte om at forsvinde for altid"
