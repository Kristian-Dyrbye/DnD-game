    "questTypes/hunt_fugitive/outcomes/turn_in/claim": {
      "hash": "2c280569",
      "text": "Udlever {antagonist} til {patron}"
    },
    "questTypes/hunt_fugitive/outcomes/turn_in/text": {
      "hash": "61d51e54",
      "text": "{antagonist} er bundet og klar til turen tilbage."
    },
    "questTypes/hunt_fugitive/outcomes/kill/label": {
      "hash": "a4ffd943",
      "text": "Gør det af med {antagonist} her og nu"
    },
    "questTypes/hunt_fugitive/outcomes/kill/claim": {
      "hash": "8ccefb57",
      "text": "Fortæl {patron}, at {antagonist} er død"
