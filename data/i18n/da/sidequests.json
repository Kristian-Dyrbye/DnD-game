      "hash": "00ab185c",
      "text": "Bestik en håndlanger til at udlevere {antagonist}"
    },
    "questTypes/hunt_fugitive/approaches/4/success": {
      "hash": "0afd96c5",
      "text": "Mønter skifter hænder; samme nat bliver {antagonist} leveret bundet og kneblet."
