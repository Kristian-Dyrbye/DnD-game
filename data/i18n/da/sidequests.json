    "questTypes/hunt_fugitive/outcomes/let_go/claim": {
      "hash": "fc1f70ab",
      "text": "Fortæl {patron}, at {antagonist} slap væk"
    },
    "questTypes/hunt_fugitive/outcomes/let_go/text": {
      "hash": "8658f171",
      "text": "{antagonist} stirrer på dig og forsvinder så ud i mørket uden et ord."
    },
    "questTypes/clear_lair/name": {
      "hash": "cd5176e3",
      "text": "Ryd en hule"
    },
