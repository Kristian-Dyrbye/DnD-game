      "hash": "7d69d4b7",
      "text": "Få indgangen til at styrte sammen, så intet slår sig ned her igen"
    },
    "questTypes/clear_lair/outcomes/destroy/claim": {
      "hash": "8516a55a",
      "text": "Fortæl {patron}, at stedet er ryddet for altid"
    },
    "questTypes/clear_lair/outcomes/destroy/text": {
      "hash": "e8b1d798",
