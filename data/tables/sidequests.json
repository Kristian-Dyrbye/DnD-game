{
  "$comment": "Side-quest generator tables (spec §7.4). The generator (A108) combines a quest type, a site, an antagonist, a complication, a twist and a reward into a normal adventure (ADVENTURE_FORMAT.md). `threads` are woven-in hooks from data/adventures/DESIGN.md §14: when their condition holds, the generator prefers them. {placeholders} are filled by the generator. Monster ids are SRD 5.2.1; location ids and regions come from data/world/lore.json.",
  "questTypes": [
    { "id": "hunt_fugitive", "name": "Hunt a fugitive", "weight": 3, "goal": "Track down {antagonist} and bring them to justice", "siteKinds": ["hideout", "wilds", "ruin"], "antagonistKinds": ["outlaw", "cultist", "pirate"], "skills": ["survival", "investigation", "insight"], "fight": true },
    { "id": "clear_lair", "name": "Clear a lair", "weight": 3, "goal": "Clear {antagonist} out of {site}", "siteKinds": ["lair", "ruin", "cave"], "antagonistKinds": ["beast", "monster", "undead"], "skills": ["stealth", "perception", "athletics"], "fight": true },
    { "id": "rescue", "name": "Rescue a captive", "weight": 2, "goal": "Rescue {patron}'s {relative} from {antagonist}", "siteKinds": ["hideout", "cave", "ruin"], "antagonistKinds": ["outlaw", "cultist", "monster"], "skills": ["stealth", "athletics", "persuasion"], "fight": true },
    { "id": "fetch", "name": "Recover an item", "weight": 2, "goal": "Recover {patron}'s {heirloom} from {site}", "siteKinds": ["ruin", "cave", "wilds"], "antagonistKinds": ["beast", "undead", "monster"], "skills": ["investigation", "athletics", "acrobatics"], "fight": false },
    { "id": "escort", "name": "Escort", "weight": 2, "goal": "Escort {patron} safely to {destination}", "siteKinds": ["road"], "antagonistKinds": ["outlaw", "beast", "pirate"], "skills": ["perception", "survival", "insight"], "fight": true },
    { "id": "investigate", "name": "Investigate a mystery", "weight": 2, "goal": "Find out who is behind {mystery}", "siteKinds": ["town", "hideout"], "antagonistKinds": ["cultist", "outlaw"], "skills": ["investigation", "insight", "persuasion"], "fight": false },
    { "id": "deliver", "name": "Deliver in time", "weight": 1, "goal": "Deliver {parcel} to {destination} before {deadline}", "siteKinds": ["road"], "antagonistKinds": ["outlaw", "beast", "pirate"], "skills": ["survival", "athletics"], "fight": false },
    { "id": "negotiate", "name": "Settle a dispute", "weight": 1, "goal": "Settle the quarrel between {patron} and {rival}", "siteKinds": ["town"], "antagonistKinds": ["rival"], "skills": ["persuasion", "insight", "deception"], "fight": false }
  ],
  "sites": [
    { "id": "bandit_camp", "kind": "hideout", "regions": ["aurelmark"], "name": "a bandit camp in the hills", "seed": "Tents and a smoky firepit behind a screen of thorn bushes; a lookout dozes on a boulder." },
    { "id": "ruined_watchtower", "kind": "ruin", "regions": ["aurelmark", "gloamfen"], "name": "a ruined watchtower", "seed": "A cracked tower of grey stone, its stair half-collapsed and its roof open to the sky." },
    { "id": "old_mine", "kind": "cave", "regions": ["aurelmark"], "name": "an abandoned mine", "seed": "Rotting timber props hold up a low tunnel; old rails vanish into the dark." },
    { "id": "forest_glade", "kind": "wilds", "regions": ["aurelmark"], "name": "a quiet forest glade", "seed": "Sunlight slants through oaks onto a mossy glade; something has flattened the ferns." },
    { "id": "wolf_den", "kind": "lair", "regions": ["aurelmark"], "name": "a den under a fallen oak", "seed": "Gnawed bones litter the ground before a dark hollow under the roots." },
    { "id": "fen_shack", "kind": "hideout", "regions": ["gloamfen"], "name": "a stilt-shack in the fen", "seed": "A shack on rotting stilts above black water, lit by a single guttering candle." },
    { "id": "drowned_crypt", "kind": "ruin", "regions": ["gloamfen"], "name": "a half-drowned crypt", "seed": "Stone steps lead down into ankle-deep water; carved names on the walls are worn smooth." },
    { "id": "bog_hollow", "kind": "lair", "regions": ["gloamfen"], "name": "a hollow in the deep bog", "seed": "Reeds tower overhead; the ground quakes underfoot and bubbles break the surface." },
    { "id": "fen_causeway", "kind": "road", "regions": ["gloamfen"], "name": "the old fen causeway", "seed": "A raised causeway of sunken logs winds between pools of fog." },
    { "id": "sea_cave", "kind": "cave", "regions": ["brinescatter_isles"], "name": "a tidal sea cave", "seed": "Waves boom in a cave mouth that floods at high tide; barnacled crates are stacked on a ledge." },
    { "id": "smugglers_cove", "kind": "hideout", "regions": ["brinescatter_isles"], "name": "a smugglers' cove", "seed": "A crescent beach hidden by cliffs, a rowboat pulled up among the rocks." },
    { "id": "wreck", "kind": "ruin", "regions": ["brinescatter_isles"], "name": "a beached shipwreck", "seed": "The ribs of a great ship lie on the sand, its hold gaping and dark." },
    { "id": "jungle_ruin", "kind": "lair", "regions": ["brinescatter_isles"], "name": "a vine-choked island ruin", "seed": "Parrots screech above stone steps swallowed by vines and roots." },
    { "id": "coast_road", "kind": "road", "regions": ["brinescatter_isles", "aurelmark"], "name": "the coast road", "seed": "A windswept road along the cliffs, gulls wheeling below." },
    { "id": "kings_road", "kind": "road", "regions": ["aurelmark"], "name": "the king's road", "seed": "A paved road lined with milestones, busy with carts by day." },
    { "id": "market_town", "kind": "town", "regions": ["aurelmark", "gloamfen", "brinescatter_isles"], "name": "the market and its back alleys", "seed": "Stalls, gossip and narrow alleys where people speak in low voices." }
  ],
